# 商品期货 Trading Agents 系统 - 环境变量
# 复制为 .env 并填入真实值

# 百炼(DashScope) API配置
DASHSCOPE_API_KEY=your_dashscope_api_key_here
BAILIAN_BASE_URL=https://llm-4l8sihiptwf8zykd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Serper API配置（新闻搜索）
SERPER_API_KEY=your_serper_api_key_here

# 天行API Key（新闻检索 tianapi 数据源，配置在系统环境变量 TIAN_API_KEY 中）
