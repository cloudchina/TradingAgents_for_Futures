# 商品期货 Trading Agents 系统 - 后端配置
# 使用前请复制为 .env 并填入真实的API密钥

# 百炼(DashScope) API配置（必需）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
BAILIAN_BASE_URL=https://llm-4l8sihiptwf8zykd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Serper API配置（可选，用于新闻搜索）
SERPER_API_KEY=your_serper_api_key_here

# 天行API Key（新闻检索 tianapi 数据源，配置在系统环境变量 TIAN_API_KEY 中）
TIAN_API_KEY=
# 新闻配置文件路径（默认自动查找仓库 config/news_config.json 或 backend/config/news_config.json）
# NEWS_CONFIG_PATH=

# SMTP 邮件配置（可选，用于定时分析的 auto_email 自动发送报告邮件）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 数据路径（Docker部署时通过环境变量 DATA_ROOT_DIR 覆盖）
DATA_ROOT_DIR=./data/qihuo/database
RESULTS_DIR=./data/qihuo/trading_agents_results
LOGS_DIR=./data/logs
CACHE_DIR=./data/qihuo/cache/analysis
